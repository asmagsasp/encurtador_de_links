# Porta local
PORT=5000

# URL pública da aplicação (na Vercel: https://seu-app.vercel.app)
BASE_URL=http://localhost:5000

# Credenciais do Administrador
ADMIN_USER=admin
ADMIN_PASS=admin123

# Segredo da sessão Express
SESSION_SECRET=linkcurto-super-secret-key-change-me

# Configuração do Turso LibSQL (Obrigatório na Vercel / Opcional localmente)
TURSO_DATABASE_URL=libsql://seu-banco-nome.turso.io
TURSO_AUTH_TOKEN=seu_token_aqui
